# Caddy in front of the monitoring tool: HTTPS with a certificate from
# Let's Encrypt (or ZeroSSL), renewed by Caddy itself. DOMAIN comes from
# .env (see compose.yaml); its DNS must point at this machine, and ports
# 80 and 443 must be open to the internet for the certificate.
#
# With DOMAIN=localhost Caddy uses a certificate of its own local CA
# instead, for a try on your own machine (browsers warn about it).

{$DOMAIN} {
	# Compress the dashboard and API answers; SDK traffic is compressed by the SDKs.
	encode zstd gzip
	# Caddy sends X-Forwarded-For, X-Forwarded-Proto and X-Forwarded-Host
	# itself; the tool reads X-Forwarded-For only for the sign-in limits.
	reverse_proxy app:8000
}
